# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# SMS Sending Control
# Set to 'true' to actually send SMS messages, 'false' for testing without sending
ENABLE_SMS_SENDING=false  # Your Twilio phone number in E.164 format

# Optional: Webhook configuration
# Make sure to configure your Twilio webhook URL to point to:
# https://your-domain.com/sms/webhook