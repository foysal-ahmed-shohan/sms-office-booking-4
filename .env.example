# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/sms_service_db
DB_ECHO=false  # Set to true to log SQL queries
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Feature Flags
# Set to 'true' to actually send SMS messages, 'false' for testing without sending
ENABLE_SMS_SENDING=false

# Set to 'true' to validate Twilio request signatures, 'false' to bypass validation
VALIDATE_TWILIO_SIGNATURE=true

# Server Configuration (optional)
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=10485760  # 10MB in bytes
LOG_BACKUP_COUNT=5     # Keep 5 backup files  # Your Twilio phone number in E.164 format

# Optional: Webhook configuration
# Make sure to configure your Twilio webhook URL to point to:
# https://your-domain.com/sms/webhook